# Build the checkout's frontend, not the unpublished OpenBot server.
# Bun 1.4.3-slim: matches packageManager and the upstream management-agent Dockerfile.
FROM oven/bun@sha256:14a223fa35747ec728bce300ef85888bc5f7958164d15bbba6a54b22b52a3288 AS frontend
WORKDIR /src
COPY package.json bun.lock ./
COPY app/package.json app/package.json
COPY shared/package.json shared/package.json
COPY extension/package.json extension/package.json
COPY management-agent/package.json management-agent/package.json
RUN bun install --frozen-lockfile
COPY tsconfig.base.json ./
COPY app/index.html app/vite.config.ts app/tsconfig.json app/
COPY app/src/ app/src/
COPY shared/ shared/
COPY scripts/generate-app-config.ts scripts/
COPY config/ipix/ config/ipix/
# Railway's runtime package path must not leak into the build-time generator.
ENV TENANT_PACKAGE_DIR=/src/config/ipix
RUN bun run --filter app build

# OpenBot v1.1.2, verified against the published image used in the first Railway pilot.
FROM ghcr.io/copilotkit/openbot@sha256:9d54d34c6bd269e9c2c331e33438ed243e73d031804877e14e57b9ba2934034d
RUN rm -rf /app/app/dist
COPY --from=frontend /src/app/dist/ /app/app/dist/
COPY --from=frontend /src/config/ipix/ /app/config/ipix/
RUN set -eu; \
    for name in brand agents channels model knowledge; do \
        test -s "/app/config/ipix/$name.yaml"; \
    done; \
    chmod a+rx /app/config; \
    chmod -R a+rX /app/app/dist /app/config/ipix; \
    chmod -R a-w /app/config/ipix
ENV TENANT_PACKAGE_DIR=/app/config/ipix PORT=3001 SERVER_PORT=3001
# Keep the vendor's /init entrypoint: it supervises the API, browser and optional PostgreSQL.
